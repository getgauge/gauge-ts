{
  "name": "gauge-ts",
  "version": "0.6.0",
  "description": "Typescript runner for Gauge",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "preclean:build": "node -e \"['dist','deploy','artifacts'].forEach((dir) => require('fs').rmSync(dir, { recursive: true, force: true }))\"",
    "build": "tsc",
    "clean:build": "pnpm run build",
    "package": "./build.sh package",
    "precommit": "pnpm run format && pnpm run lint",
    "test": "vitest run",
    "gen-proto": "sh genproto.sh",
    "prepublishOnly": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getgauge/gauge-ts.git"
  },
  "keywords": ["gauge", "Acceptance Test", "Typescript", "Automation"],
  "author": "Gauge <getgauge@outlook.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/getgauge/gauge-ts/issues"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.1",
    "@grpc/grpc-js": "^1.14.4",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "1.7.3",
    "@types/node": "^26.2.0",
    "grpc-tools": "^1.12.4",
    "husky": "^9.0.11",
    "ts-proto": "^2.12.0",
    "vitest": "^4.1.11"
  }
}
