{
  "compilerOptions": {
    "target": "esnext",
    "module": "commonjs",
    "lib": ["es2024"],
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "./src",
    "moduleResolution": "bundler",
    "plugins": [
      {
        "cacheBetweenTests": false
      }
    ]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "**/*.spec.ts"]
}
