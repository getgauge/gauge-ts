{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext"],
    "strict": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "useDefineForClassFields": false,
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "@lib/*": ["./src/*"]
    }
  },
  "include": ["tests/**/*", "src/**/*"],
  "exclude": ["node_modules/"]
}
